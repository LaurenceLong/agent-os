# Agent-OS live LLM test configuration.
# These variables are for ignored live provider tests only.
# Runtime provider configuration lives in the global providers.json file.

AGENT_OS_LIVE_OPENAI_API_KEY=replace-with-openai-compatible-test-key
AGENT_OS_LIVE_OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_OS_LIVE_OPENAI_MODEL=gpt-4o

AGENT_OS_LIVE_ANTHROPIC_API_KEY=replace-with-anthropic-compatible-test-key
AGENT_OS_LIVE_ANTHROPIC_BASE_URL=https://api.anthropic.com
AGENT_OS_LIVE_ANTHROPIC_MODEL=claude-sonnet-4-20250514
